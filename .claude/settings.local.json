{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "Skill(*)",
      "Agent(*)",
      "TodoWrite(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "AskUserQuestion(*)",
      "CronCreate(*)",
      "CronDelete(*)",
      "CronList(*)",
      "EnterWorktree(*)",
      "ExitWorktree(*)",
      "EnterPlanMode(*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyWrite": ["/"],
      "allowWrite": ["/root/twoannealing", "/tmp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /root/twoannealing && if [ -n \"$(git status --porcelain 2>/dev/null)\" ]; then git add -A && git commit -m \"$(date '+%Y-%m-%d %H:%M') - auto commit\" && git push origin Richardlei 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
